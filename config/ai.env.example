# 复制为 config/ai.env 后填写。不要把真实 API Key 提交到 Git。
# 启动脚本每次启动都会读取这个文件，因此 Windows 重启后也不会丢失配置。

KIMI_API_KEY=请在这里填写你的Kimi_API_Key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
KIMI_FAST_MODE=true

# 可选：配置 OpenAI 兼容 Embedding 服务后，课程 RAG 会增加向量召回；不配置时自动使用本地混合检索。
# AI_EMBEDDING_ENABLED=false
# AI_EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
# AI_EMBEDDING_API_KEY=请填写Embedding服务密钥
# AI_EMBEDDING_MODEL=text-embedding-3-small

# AI 接口保护参数（默认每用户每分钟 30 次，最多同时 3 个请求）
# AI_REQUESTS_PER_MINUTE=30
# AI_MAX_CONCURRENT=3

# 如果当前网络必须经过代理，再取消注释并填写；不需要代理时保持为空或删除。
# KIMI_PROXY_HOST=127.0.0.1
# KIMI_PROXY_PORT=7890

# 注册/找回密码邮箱验证码。正式环境必须使用 smtp，MAIL_PASSWORD 填邮箱服务商提供的 SMTP 授权码，不能填网页登录密码。
# VERIFICATION_PROVIDER=smtp
# MAIL_HOST=smtp.qq.com
# MAIL_PORT=465
# MAIL_USERNAME=your-account@qq.com
# MAIL_PASSWORD=请填写SMTP授权码
# MAIL_SSL=true
# MAIL_STARTTLS=false
